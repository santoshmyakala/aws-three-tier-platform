#!/bin/bash
# WireGuard gateway. Server keys are generated on first boot and never leave the instance.
# Add client peers with: wg set wg0 peer <client-public-key> allowed-ips <client-tunnel-ip>/32
set -euo pipefail
apt-get update -y
apt-get install -y wireguard iptables
umask 077
wg genkey | tee /etc/wireguard/server.key | wg pubkey > /etc/wireguard/server.pub
SERVER_IP=$(echo "${client_cidr}" | awk -F'[./]' '{print $1"."$2"."$3".1/"$5}')
IFACE=$(ip route show default | awk '{print $5}')
cat > /etc/wireguard/wg0.conf <<CONF
[Interface]
Address = $SERVER_IP
ListenPort = 51820
PrivateKey = $(cat /etc/wireguard/server.key)
PostUp = iptables -A FORWARD -i wg0 -d ${vpc_cidr} -j ACCEPT; iptables -A FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT
PostDown = iptables -D FORWARD -i wg0 -d ${vpc_cidr} -j ACCEPT; iptables -D FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT
CONF
echo "net.ipv4.ip_forward = 1" > /etc/sysctl.d/99-wireguard.conf
sysctl --system
systemctl enable --now wg-quick@wg0
